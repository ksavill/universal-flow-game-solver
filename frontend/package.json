{
  "name": "universal-flow-game-solver-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-local-runtime.mjs",
    "prebuild": "node scripts/prepare-local-runtime.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "dev:static": "node scripts/prepare-local-runtime.mjs && vite --mode static --host",
    "build:static": "node scripts/prepare-local-runtime.mjs && tsc -b && vite build --mode static && node scripts/verify-static-build.mjs",
    "check:static": "node scripts/verify-static-build.mjs",
    "preview:static": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:static": "npm run build:static && wrangler deploy",
    "preview": "vite preview --host",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.16.10",
    "@mui/material": "^5.16.10",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image-crop": "^11.0.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "z3-solver": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^5.0.1",
    "wrangler": "4.145.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2"
  }
}
